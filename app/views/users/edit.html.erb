<style>
    .form-error{
        color: #d2322d;
    }
</style>
<div>
  <h1>Редактирование профиля</h1>
  <p>Можете заполнить только те поля, которые хотите изменить</p>
  <div class="form">
    <%= form_for @user do |f| %>

      <% if @user.errors.any? %>
        <div class="form-error">
          <ul>
            <% @user.errors.full_messages.each do |m| %>
              <li><%= m %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, 'Имя' %>
        <%= f.text_field :name %>
      </div>
      <div>
        <%= f.label :email, 'Логин(email)' %>
        <%= f.text_field :email %>
      </div>
      <div>
        <%= f.label :username, 'Никнейм' %>
        <%= f.text_field :username %>
      </div>
      <div>
        <%= f.label :password, 'Пароль' %>
        <%= f.password_field :password %>
      </div>
      <div>
        <%= f.label :password_confirmation, 'Повторите пароль' %>
        <%= f.password_field :password_confirmation %>
      </div>
      <div>
        <%= f.submit 'Изменить данные' %>
      </div>
    <% end %>
  </div>
</div>